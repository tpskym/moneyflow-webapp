{
  "name": "M-Flow",
  "short_name": "M-Flow",
  "description": "Личный учет доходов и расходов",
  "start_url": "./",
  "display": "standalone",
  "background_color": "transparent",
  "theme_color": "#020617",
  "scope": "./",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "./receive-check/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "receipts",
          "accept": ["image/jpeg", "image/png", "image/webp", "application/pdf", ".jpg", ".jpeg", ".png", ".webp", ".pdf"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icons/moneyflow.svg?v=120",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
